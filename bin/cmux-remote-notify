#!/bin/bash
# cmux-remote-notify: when Claude Code or Codex finishes (or waits for you) on a remote machine
# you reached over SSH or Eternal Terminal (with or without tmux), notify the cmux tab it runs in
# and show the agent's status (Running, Needs input, Idle) in the cmux sidebar.
#
# Remote: hook.py appends one line to ~/.local/state/cmux-remote-notify/events.jsonl whenever
#         an agent starts, finishes or waits, with the logins it is seen from (viewers).
# Mac:    `watch` follows that file over SSH, finds the tab that shows the agent, notifies it with
#         `cmux notify` and sets the status line of its workspace with `cmux set-status`.
#         With no such tab it falls back to a macOS banner.
#
# Runs on the stock macOS bash 3.2.

set -u

VERSION=0.7.0
NAME=cmux-remote-notify
LABEL_PREFIX=io.github.zoo3323.$NAME
# launchd cannot read files under ~/Desktop or ~/Documents (TCC), so the running copy lives here.
SHARE_DIR=$HOME/.local/share/$NAME
STATE_DIR=${CMUX_REMOTE_NOTIFY_STATE:-$HOME/.local/state/$NAME}
LOG_DIR=$HOME/Library/Logs/$NAME
AGENT_DIR=${CMUX_REMOTE_NOTIFY_AGENTS:-$HOME/Library/LaunchAgents}
BIN_LINK=$HOME/.local/bin/$NAME
STALE_SECONDS=600        # older events (piled up while the Mac slept) mark the tab without a banner
RECONNECT_SECONDS=15     # wait before reconnecting; doubles on quick failures up to MAX
MAX_RECONNECT_SECONDS=60
# The remote writes '#hb' this often. When the Mac sleeps and the link dies, that write blocks and
# the remote sshd/tail exit within the TCP retransmission limit (about 15 minutes) instead of hours.
HEARTBEAT_SECONDS=60
LOG_KEEP_LINES=2000
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3"
# Remote paths are passed as is so the remote shell expands $HOME.
REMOTE_SHARE='$HOME/.local/share/cmux-remote-notify'
REMOTE_STATE='$HOME/.local/state/cmux-remote-notify'
US=$'\037'               # field separator; unlike a space it keeps empty fields
# Only these programs count as a connection from a tab (ssh, autossh, et, the et that ezet
# manages, and mosh-client). A shell command line that merely mentions a host is never mistaken for one.
CONNECT_CMD_RE=${CMUX_REMOTE_NOTIFY_CONNECT_RE:-'(^|/)(ssh|autossh|et|mosh-client)$|/ezet/et/[^/]+$'}

export PATH="/Applications/cmux.app/Contents/Resources/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
CMUX=${CMUX_BIN:-cmux}

# ---------------------------------------------------------------- language
# English by default, Korean when macOS (or the locale) prefers Korean.
# CMUX_REMOTE_NOTIFY_LANG=en|ko overrides.
detect_lang() {
  local l
  case ${CMUX_REMOTE_NOTIFY_LANG:-} in en|ko) printf '%s' "$CMUX_REMOTE_NOTIFY_LANG"; return ;; esac
  l=$(defaults read -g AppleLanguages 2>/dev/null | sed -n '2s/[^A-Za-z-]//gp')
  [ -n "$l" ] || l=${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}
  case $l in ko*) printf ko ;; *) printf en ;; esac
}
UI_LANG=$(detect_lang)
# L "English" "한국어"
L() { if [ "$UI_LANG" = ko ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
die() { printf '%s: %s\n' "$NAME" "$*" >&2; exit 1; }

usage() {
  if [ "$UI_LANG" = ko ]; then
    cat <<EOF
$NAME $VERSION: 원격(SSH·ET, tmux 는 써도 안 써도 됨)의 Claude Code·Codex 작업이 끝나면 cmux 탭에 알리고
Claude 상태(Running·Needs input·Idle)를 그 탭의 사이드바에 띄운다

사용법:
  $NAME install <장비> [--label 이름]   원격에 훅을 넣고 맥 감시를 켠다
  $NAME uninstall <장비>                원격 훅과 맥 감시를 뺀다
  $NAME status                          감시 상태와 최근 기록
  $NAME doctor [장비]                   전부 점검하고 고치는 법을 알려 준다
  $NAME test <장비> [세션]              시험 알림 한 번 (세션을 빼면 열린 탭 중 하나)
  $NAME label <장비> [이름]             사이드바에 보일 장비 이름 (이름을 빼면 지움)
  $NAME watch <장비>                    감시 실행 (launchd 가 부른다)

<장비> 는 ssh 로 붙는 이름이다 (~/.ssh/config 의 Host, 예: gpu-box).
EOF
  else
    cat <<EOF
$NAME $VERSION: notify the cmux tab when Claude Code or Codex finishes on a remote
machine (SSH or ET, in tmux or not), and show Running, Needs input or Idle in its sidebar

usage:
  $NAME install <host> [--label NAME]   add the remote hooks and start watching from this Mac
  $NAME uninstall <host>                remove the remote hooks and stop watching
  $NAME status                          watcher state and recent log
  $NAME doctor [host]                   check everything and say how to fix what is wrong
  $NAME test <host> [session]           send one test notification (default: an open tab's session)
  $NAME label <host> [NAME]             name shown for the host in the sidebar (omit NAME to clear)
  $NAME watch <host>                    run the watcher (launchd calls this)

<host> is what you pass to ssh (a Host in ~/.ssh/config, for example gpu-box).
EOF
  fi
}

check_host() {
  case $1 in
    ''|-*|*[!A-Za-z0-9._@-]*) die "$(L "invalid host name: '$1' (example: gpu-box)" "장비 이름이 올바르지 않아요: '$1' (예: gpu-box)")" ;;
  esac
}

label_for() { printf '%s.%s' "$LABEL_PREFIX" "$1"; }
plist_for() { printf '%s/%s.plist' "$AGENT_DIR" "$(label_for "$1")"; }
shell_quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Follow symlinks to the top directory (the repository or the installed copy) of this script.
script_root() {
  local src=$0 dir
  while [ -h "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case $src in /*) ;; *) src=$dir/$src ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}

# ---------------------------------------------------------------- finding tabs
# Print "tty<TAB>host<TAB>session<TAB>started<TAB>pid<TAB>kind<TAB>mip<TAB>mport" for every
# ssh/et/mosh connection that runs in a terminal. kind is ssh, et or mosh; mip and mport are the
# server address and UDP port of a mosh connection.
# host drops user@ and :port. session is the tmux session named on the command line
# (new-session -s NAME, attach -t NAME), or empty when it cannot be told. started is when the
# connection began (epoch seconds).
#   ssh -t gpu-box tmux new -A -s train
#   et gpu-box -c "tmux attach -t train"
#   ezet: et ... gpu-box -c '/usr/bin/tmux' -L 'ezet-x' new-session -A -s 'train'
#   mosh-client -# gpu-box tmux a -t train | 10.0.0.9 60001   (what `mosh gpu-box ...` runs)
#   ssh gpu-box                       (tmux started by hand: session unknown)
# ps joins the arguments with spaces, so `et -c "tmux a -t x" host` cannot be split back exactly.
# Known host names (the arguments, plus every installed host) are looked for first; the first
# argument that is not an option is the fallback.
connect_tabs() {
  local known
  known=" $(printf '%s ' "$@" $(installed_hosts) | sed 's/[^ ]*@//g') "
  ps -axo tty=,etime=,pid=,args= | awk -v re="$CONNECT_CMD_RE" -v known="$known" -v now="${CMUX_REMOTE_NOTIFY_NOW:-$(date +%s)}" '
    function unq(s) { gsub(/^["\047]+|["\047;]+$/, "", s); return s }
    function base(s) { sub(/.*\//, "", s); return s }
    # ps etime [[dd-]hh:]mm:ss in seconds
    function secs(t,   d, n, p, i, x) {
      d = 0; if (index(t, "-")) { d = substr(t, 1, index(t, "-") - 1); t = substr(t, index(t, "-") + 1) }
      n = split(t, p, ":"); x = 0; for (i = 1; i <= n; i++) x = x * 60 + p[i]
      return d * 86400 + x
    }
    # take out etime and pid so the fields are: tty, program, arguments
    { started = now - secs($2); pid = $3; $2 = ""; $3 = ""; $0 = $0 }
    $1 == "??" || $1 == "-" || $1 == "" { next }
    $2 !~ re { next }
    {
      prog = base($2)
      kind = (prog == "et" || $2 ~ /\/ezet\/et\//) ? "et" : (prog == "mosh-client" ? "mosh" : "ssh")
      mip = ""; mport = ""
      if (kind == "mosh") {
        # mosh-client -# <the mosh command line> | <server address> <UDP port>
        k = 0; for (i = 3; i <= NF; i++) if ($i == "|") k = i
        if (!k) next
        mip = $(k + 1); mport = $(k + 2); NF = k - 1
      }
      # options that take a value, so the value is not taken for the host
      if (kind == "mosh") { sv = "p"; lv = " --ssh --port --predict --family --server --client --bind-server --experimental-remote-ip " }
      else if (kind == "et") { sv = "ucptrvkl"; lv = " --username --port --command --terminal-path --tunnel --reversetunnel --jumphost --jport --jserverfifo --verbose --keepalive --logdir --ssh-socket --ssh-config --ssh-option " }
      else { sv = "BbcDEeFIiJLlmOoPpQRSWw"; lv = " " }
      hi = 0; skip = 0
      for (i = 3; i <= NF; i++) {
        a = $i
        if (a == "--") { hi = i + 1; break }
        if (a ~ /^--/) { if (a !~ /=/ && index(lv, " " a " ")) i++; continue }
        if (a ~ /^-./) {
          if (kind != "et" && a ~ /^-[WNO]/) skip = 1   # ssh -W/-N/-O: a jump, tunnel or control call
          if (length(a) == 2 && index(sv, substr(a, 2, 1))) i++
          continue
        }
        hi = i; break
      }
      if (skip) next
      host = ""
      if (hi && hi <= NF) { x = unq($hi); sub(/^.*@/, "", x); sub(/:[0-9]+$/, "", x); if (index(known, " " x " ")) host = x }
      for (i = 3; host == "" && i <= NF; i++) {
        x = unq($i); sub(/^.*@/, "", x); sub(/:[0-9]+$/, "", x)
        if (x != "" && index(known, " " x " ")) { host = x; break }
      }
      if (host == "" && hi && hi <= NF) { host = unq($hi); sub(/^.*@/, "", host); sub(/:[0-9]+$/, "", host) }
      if (host == "") next

      # find "tmux" anywhere after the program, then its command and session flag
      n = 0; for (i = 3; i <= NF; i++) w[++n] = $i
      tm = 0
      for (j = 1; j <= n; j++) if (base(unq(w[j])) == "tmux") { tm = j; break }
      s = ""
      if (tm) {
        cmd = ""
        for (j = tm + 1; j <= n; j++) {
          x = unq(w[j])
          if (cmd == "") {
            if (x ~ /^-[LSfcT]$/) { j++; continue }
            if (x ~ /^-/) continue
            cmd = x; continue
          }
          isnew = (cmd == "new" || (length(cmd) >= 5 && index("new-session", cmd) == 1))
          isatt = (cmd == "a" || (length(cmd) >= 2 && index("attach-session", cmd) == 1))
          if (j < n && ((isnew && x == "-s") || (isatt && x == "-t"))) {
            v = w[j + 1]; k = j + 1
            # a quoted name with spaces spans several words
            if (v ~ /^\047/ && v !~ /\047;?$/) {
              for (k = j + 2; k <= n; k++) { v = v " " w[k]; if (w[k] ~ /\047;?$/) break }
            }
            s = unq(v)
            if (isatt) sub(/:.*$/, "", s)
            j = k
            # tmux new -s a \; attach -t b: the last one is the one you see
            if (w[k] ~ /;$/) cmd = ""
            continue
          }
          if (x == ";" || x == "\\;" || w[j] ~ /;$/) cmd = ""
        }
      }
      printf "%s\t%s\t%s\t%d\t%s\t%s\t%s\t%s\n", $1, host, s, started, pid, kind, mip, mport
    }'
}

# Lines "tty session" for tabs connected to this host (host without user@).
open_tabs() {
  local h=${1##*@}
  connect_tabs "$h" | awk -F '\t' -v h="$h" '$2 == h { print $1, $3 }'
}

# Connections as JSON {tty, host, session, started, pid, kind, mip, mport, rows, cols}.
# rows and cols are the tab's terminal size (stty only reads it).
tabs_json() {
  local list tty sizes=""
  list=$(connect_tabs "$@")
  for tty in $(printf '%s\n' "$list" | cut -f 1 | sort -u); do
    sizes="$sizes$tty $(stty -f "/dev/$tty" size 2>/dev/null)
"
  done
  printf '%s\n' "$list" | jq -R -s -c --arg sizes "$sizes" '
    ($sizes | split("\n") | map(split(" ") | select(length == 3) | {key: .[0], value: [(.[1] | tonumber), (.[2] | tonumber)]})
     | from_entries) as $size
    | split("\n") | map(select(length > 0) | split("\t")
    | {tty: .[0], host: .[1], session: (.[2] // ""), started: ((.[3] // "0") | tonumber),
       pid: ((.[4] // "0") | tonumber), kind: (.[5] // "ssh"), mip: (.[6] // ""),
       mport: ((.[7] // "") | tonumber? // null)}
    | . + {rows: ($size[.tty][0] // null), cols: ($size[.tty][1] // null)})'
}

# This Mac's established TCP connections as JSON {pid, lport, rport, rip, mux}. mux marks an ssh
# ControlMaster, whose connection carries the sessions of other ssh processes.
conns_json() {
  local pids
  lsof -nP -iTCP -sTCP:ESTABLISHED -F pn 2>/dev/null | awk '
    /^p/ { pid = substr($0, 2) }
    /^n/ { n = split(substr($0, 2), e, "->"); if (n != 2) next
           l = e[1]; sub(/.*:/, "", l); r = e[2]; sub(/.*:/, "", r)
           ip = e[2]; sub(/:[0-9]+$/, "", ip); gsub(/[][]/, "", ip); print pid, l, r, ip }' > "$STATE_DIR/.conns"
  pids=$(awk '{ print $1 }' "$STATE_DIR/.conns" | sort -u | tr '\n' ',' | sed 's/,$//')
  { [ -z "$pids" ] || ps -o pid=,args= -p "$pids" 2>/dev/null | awk '$0 ~ /\[mux\] *$/ { print "mux", $1 }'
    cat "$STATE_DIR/.conns"; } | jq -R -s -c 'split("\n") | map(select(length > 0) | split(" "))
    | (map(select(.[0] == "mux") | .[1])) as $mux
    | map(select(.[0] != "mux") | {pid: (.[0] | tonumber), lport: (.[1] | tonumber),
        rport: (.[2] | tonumber), rip: (.[3] // ""), mux: (.[0] as $p | $mux | index($p) != null)})' 2>/dev/null || echo '[]'
}

# jq definitions shared by the sidebar and notifications. They need $host, $tabs and $conns.
# A session's tabs are
#   1. tabs whose command line names the tmux session (`tmux new -A -s NAME`) on this host
#   2. the tabs of its viewers, the logins the remote says it is seen from:
#      ssh   the tab whose ssh holds the Mac port in SSH_CONNECTION
#      mosh  the tab whose mosh-client talks to that server UDP port
#      else  (et, a shared ControlMaster, ProxyJump) the tab that connected when the login
#            started; logins within 2 seconds of each other are told apart by terminal size
# A viewer's tab may name the host differently (user@address, another alias): the address the
# tab is connected to counts as the same host. A tab whose command line names another tmux
# session is never taken.
MATCH_JQ='
  def rips($t): [ $conns[] | select(.pid == $t.pid) | .rip ] + (if ($t.mip // "") != "" then [$t.mip] else [] end);
  def same_host($t; $v): $t.host == $host or (($v.sip // "") != "" and (rips($t) | index($v.sip)) != null);
  def near($c; $v):
    ($c | map(. + {d: ((.started - ($v.start // 0)) | if . < 0 then -. else . end)}) | sort_by(.d)) as $s
    | if ($s | length) == 0 then []
      elif $s[0].d > 30 then (if ($s | length) == 1 then $s else [] end)
      else ([ $s[] | select(.d <= $s[0].d + 2) ]) as $close
        | if ($close | length) == 1 then $close
          else [ $close[] | select($v.rows != null and .rows == $v.rows and .cols == $v.cols) ]
            | if length == 1 then . else [] end end end;
  def viewer_tabs($s; $v):
    [ $tabs[] | select(.session == "" or .session == $s) ] as $open
    | [ $open[] | select(same_host(.; $v)) ] as $mine
    | (if $v.port then [ $conns[] | select(.lport == $v.port and .rport == ($v.sport // .rport)
                          and (($v.sip // "") == "" or .rip == $v.sip)) ][0]
       else null end) as $c
    | ([ $open[] | select($c != null and .pid == $c.pid) ]) as $own
    | ([ $open[] | select($v.mport != null and .kind == "mosh" and .mport == $v.mport
                   and (($v.sip // "") == "" or .mip == $v.sip)) ]) as $mosh
    | if ($own | length) > 0 then $own
      elif ($mosh | length) > 0 then $mosh
      elif $c != null and ($c.mux | not) then []
      else near([ $mine[] | select(.kind == ($v.via // "")) ]; $v) end;
  def session_tabs($s; $w):
    [ $tabs[] | select($s != "" and .host == $host and .session == $s) ]
    + (if $w != null and $w.viewers != null then [ $w.viewers[] as $v | viewer_tabs($s; $v)[] ] else [] end)
    | unique_by(.tty);
  def known($w): $w != null and $w.viewers != null;
'

# Print "workspaceUUID surfaceUUID" for the cmux tabs that show this session.
# where is {name, viewers} from the event (null when unknown). Without viewers (an older hook),
# fall back to the one tab whose title equals the session name, then to the one tab connected to
# this host whose session could not be told.
find_targets() {
  local host=$1 session=$2 tree=$3 where=${4:-null} tabs conns
  tabs=$(tabs_json "$host")
  conns=$(conns_json)
  printf '%s\n' "$tree" | jq -r --arg host "${host##*@}" --arg s "$session" --argjson w "$where" \
    --argjson tabs "$tabs" --argjson conns "$conns" "$MATCH_JQ"'
    [ .windows[]?.workspaces[]? | (.id // "-") as $ws | .panes[]?.surfaces[]?
      | select(.type == "terminal") | {ws: $ws, id, tty: (.tty // ""), title: (.title // "")} ] as $surf
    | ([ session_tabs($s; $w)[] as $t | $surf[] | select(.tty == $t.tty) ]) as $hit
    | if ($hit | length) > 0 or known($w) or $s == "" then $hit
      else ([ $surf[] | select(.title == $s) ]) as $byname
        | if ($byname | length) == 1 then $byname
          else ([ $tabs[] | select(.host == $host and .session == "") ]) as $loose
            | if ($loose | length) == 1 then [ $surf[] | select(.tty == $loose[0].tty) ] else [] end end end
    | .[] | "\(.ws) \(.id)"' 2>/dev/null
}

tabs_by_tty() {
  printf '%s\n' "$1" | jq -r --arg ttys "$2" '
    ($ttys | split("\n")) as $t
    | .windows[]?.workspaces[]? | (.id // "-") as $w | .panes[]?.surfaces[]?
    | select(.type == "terminal") | select((.tty // "") as $x | $t | any(. == $x)) | "\($w) \(.id)"' 2>/dev/null
}


# ---------------------------------------------------------------- sidebar status
# Files per host:
#   <host>.agents.json  Claude state per session {"<session>": {"<Claude session ID>": {s, ts, since, task}}}
#                       session is the tmux session, or the remote terminal (pts/N) without tmux
#   <host>.where.json   where each session is seen from {"<session>": {name, viewers}}
#   <host>.applied      status lines set in cmux "workspace key text icon color work priority" (US-separated)
#   descriptions.json   workspace descriptions this tool wrote {workspace: text}, shared by all hosts
#   labels.json         names shown for hosts {host: label}
#
# In the sidebar each workspace shows:
#   my project
#   gpu-box                               <- description: the hosts this workspace's tabs are on
#   ⚡ train · 12m · summarize the run      <- one line per session: status, time worked, task
#                                            (named after the folder when there is no tmux)
#   ⏸ api · idle                          <- a tab with no Claude, or one that is resting
# When one tmux session holds several Claudes (claude -p inside, for example) the busiest one shows.

# Update a session's state from one event. kind: running|input|idle|done|error|end|where
# A Claude is kept under one session only: it moves when it is seen from somewhere else
# (a background session watched from another tab).
update_agents() {
  local host=$1 session=$2 sid=$3 kind=$4 ts=$5 text=$6 f new
  f=$STATE_DIR/$host.agents.json
  case $kind in running|input|idle|done|error|end|where) ;; *) return 0 ;; esac
  [ -s "$f" ] || echo '{}' > "$f"
  new=$(jq -c --arg s "$session" --arg id "$sid" --arg k "$kind" --argjson ts "$ts" --arg task "$text" '
    ([ .[] | .[$id] // empty ][0]) as $was
    | with_entries(.value |= del(.[$id])) | with_entries(select(.value | length > 0))
    | if $k == "where" then (if $was then .[$s][$id] = $was else . end)
    elif $k == "end" then
      .
    else
      ($was // {}) as $p
      | (if $k == "running" or $k == "input" then $k else "idle" end) as $st
      | .[$s][$id] = ({s: $st, ts: $ts}
          # Time worked counts from the prompt, and keeps counting across a permission prompt.
          + (if $st == "idle" then {}
             elif ($p.s // "") == "running" or ($p.s // "") == "input" then {since: ($p.since // $ts)}
             else {since: $ts} end)
          + (if $k == "running" and $task != "" then {task: $task}
             elif $p.task then {task: $p.task} else {} end))
    end' "$f" 2>/dev/null) || { echo '{}' > "$f"; return 0; }
  printf '%s\n' "$new" > "$f"
}

# Remember where a session is seen from ({name, viewers}), and forget sessions with no Claude.
update_where() {
  local host=$1 session=$2 name=$3 viewers=$4 f=$STATE_DIR/$host.where.json new
  [ -s "$f" ] || echo '{}' > "$f"
  new=$(jq -c --arg s "$session" --arg n "$name" --argjson v "$viewers" \
      --slurpfile a "$STATE_DIR/$host.agents.json" '
    (if $s != "" and $v != null then .[$s] = {name: $n, viewers: $v} else . end)
    | with_entries(select(.key as $k | ($a[0] // {}) | has($k)))' "$f" 2>/dev/null) || return 0
  printf '%s\n' "$new" > "$f"
}

# Work out what the sidebar should show. Input: the cmux tree JSON on stdin.
# Output: "row workspace key text icon color work priority" and "desc set|clear workspace text" (US-separated)
render_sidebar() {
  local host=$1 tabs=$2 now=$3 installed=$4 conns=$5
  jq -r --arg host "${host##*@}" --arg key_host "$host" --argjson tabs "$tabs" --argjson now "$now" \
    --arg us "$US" --arg lang "$UI_LANG" --argjson installed "$installed" --argjson conns "$conns" \
    --slurpfile agents "$STATE_DIR/$host.agents.json" \
    --slurpfile where "$STATE_DIR/$host.where.json" \
    --slurpfile ours "$STATE_DIR/descriptions.json" \
    --slurpfile labels "$STATE_DIR/labels.json" "$MATCH_JQ"'
    def ko: $lang == "ko";
    def key($s): ("remote." + $key_host + "." + $s) | gsub("[^A-Za-z0-9._-]"; "_");
    def dur($sec): ($sec / 60 | floor) as $m
      | if $m < 1 then (if ko then "방금" else "just now" end)
        elif $m < 60 then (if ko then "\($m)분" else "\($m)m" end)
        else ($m / 60 | floor) as $h | ($m % 60) as $r
          | if ko then "\($h)시간" + (if $r > 0 then " \($r)분" else "" end)
            else "\($h)h" + (if $r > 0 then " \($r)m" else "" end) end end;
    def uniq: reduce .[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end);

    ($agents[0] // {}) as $agents | ($ours[0] // {}) as $ours | ($labels[0] // {}) as $labels
    | ($where[0] // {}) as $where
    | [ .windows[]?.workspaces[]? | select(.id != null) | {ws: .id, desc: (.description // "")} ] as $spaces
    | [ .windows[]?.workspaces[]? | (.id // "-") as $w | (.description // "") as $d
        | .panes[]?.surfaces[]? | select(.type == "terminal")
        | {ws: $w, desc: $d, tty: (.tty // ""), title: (.title // "")} ] as $surf
    | [ $surf[] as $x | $tabs[] | select(.tty == $x.tty) | {ws: $x.ws, host, session, started} ] as $tabws
    # the single tab on this host whose session is unknown (plain `ssh host`, tmux started by hand)
    | ([ $tabws[] | select(.host == $host and .session == "") ] | if length == 1 then . else [] end) as $loose

    # one line per session
    | ( (($agents | keys) + [ $tabws[] | select(.host == $host and .session != "") | .session ] | unique)[] as $s
        | ($where[$s] // null) as $w
        | ([ session_tabs($s; $w)[] as $t | $surf[] | select(.tty == $t.tty) | .ws ] | unique) as $w1
        # No viewer information (an older hook): the one tab with that title, or the plain ssh tab.
        # A session whose tab was closed would otherwise land on that plain ssh tab, so it goes there
        # only when something happened in the session after the tab connected.
        | (([ ($agents[$s] // {})[] | .ts ] | max // 0) / 1000) as $last
        | (if ($w1 | length) > 0 or known($w) then $w1
           else ([ $surf[] | select(.title == $s) | .ws ]
                 | if length == 1 then . else [ $loose[] | select(.started <= $last) | .ws ] end) end) as $wss
        | (($w.name // "") | if . == "" then $s else . end) as $label
        | ([ ($agents[$s] // {})[] ]) as $sids
        | ((($sids | map(select(.s == "running")) | first) // ($sids | map(select(.s == "input")) | first)
            // ($sids | first))) as $a
        # A tab with no Claude shows as idle too.
        | select($a != null or ($w1 | length) > 0)
        | (if $a == null then "idle" else $a.s end) as $st
        | (if $st == "running" then [dur($now - ($a.since // $a.ts) / 1000), ($a.task // "")] | map(select(. != "")) | join(" · ")
           elif $st == "input" then [(if ko then "확인 필요" else "needs input" end), ($a.task // "")] | map(select(. != "")) | join(" · ")
           else (if ko then "대기" else "idle" end) end) as $detail
        | (if $st == "running" then ["bolt.fill", "#4C8DFF", "running", "50"]
           elif $st == "input" then ["bell.fill", "#4C8DFF", "", "100"]
           else ["pause.circle.fill", "#8E8E93", "", "30"] end) as $look
        | $wss[] | select(. != "-") | (["row", ., key($s), "\($label) · \($detail)"] + $look | join($us)) ),

    # Workspace description: the hosts its tabs are on (installed hosts, or connections running tmux).
    # A description the user wrote is never touched.
      ( $spaces[] as $x
        | [ $tabws[] | select(.ws == $x.ws) | select(.session != "" or (.host as $h | $installed | index($h))) ] as $t
        | ([ $t[].host ] | uniq | map($labels[.] // .) | join(" · ")) as $want
        | ($ours[$x.ws] // null) as $mine
        | if $want != "" and $x.desc != $want and ($x.desc == "" or $x.desc == $mine) then
            ["desc", "set", $x.ws, $want] | join($us)
          elif $want == "" and $mine != null and $x.desc == $mine and $x.desc != "" then
            ["desc", "clear", $x.ws, ""] | join($us)
          else empty end )
  '
}

# Bring the session lines and descriptions in the sidebar up to date.
# check=1 also verifies that what we set is still in cmux (restores it after cmux restarts).
sync_status() {
  local host=$1 check=${2:-0} applied tree tabs conns now out have new="" line installed
  local kind ws key label icon color work prio op desc ours rest
  applied=$STATE_DIR/$host.applied
  for f in "$STATE_DIR/$host.agents.json" "$STATE_DIR/$host.where.json" "$STATE_DIR/descriptions.json" "$STATE_DIR/labels.json"; do
    [ -s "$f" ] || echo '{}' > "$f"
  done
  tree=$("$CMUX" tree --all --json --id-format both 2>/dev/null) || return 0
  now=${CMUX_REMOTE_NOTIFY_NOW:-$(date +%s)}
  tabs=$(tabs_json "$host")
  conns=$(conns_json)
  installed=$(installed_hosts | sed 's/.*@//' | jq -R -s -c 'split("\n") | map(select(length > 0))')
  out=$(printf '%s\n' "$tree" | render_sidebar "$host" "$tabs" "$now" "$installed" "$conns") || return 0
  have=$(cat "$applied" 2>/dev/null)

  # Set the session lines.
  while IFS=$US read -r kind ws key label icon color work prio; do
    [ "$kind" = row ] || continue
    line="$ws$US$key$US$label$US$icon$US$color$US$work$US$prio"
    if printf '%s\n' "$have" | grep -qxF "$line"; then
      if [ "$check" != 1 ] || "$CMUX" list-status --workspace "$ws" 2>/dev/null | grep -qF "$key=$label icon="; then
        new="$new$line
"
        continue
      fi
    fi
    if "$CMUX" set-status "$key" "$label" --icon "$icon" --color "$color" \
         ${work:+--work "$work"} ${prio:+--priority "$prio"} --workspace "$ws" >/dev/null 2>&1; then
      new="$new$line
"
    fi
  done <<EOF
$out
EOF
  # Remove lines no longer needed (the session ended, or the tab closed or moved).
  while IFS=$US read -r ws key rest; do
    [ -n "$ws" ] || continue
    printf '%s\n' "$new" | awk -F "$US" -v w="$ws" -v k="$key" '$1 == w && $2 == k { found = 1 } END { exit !found }' \
      && continue
    "$CMUX" clear-status "$key" --workspace "$ws" >/dev/null 2>&1
  done <<EOF
$have
EOF
  printf '%s' "$new" > "$applied"

  # Descriptions
  ours=$(cat "$STATE_DIR/descriptions.json")
  while IFS=$US read -r kind op ws desc; do
    [ "$kind" = desc ] || continue
    if [ "$op" = set ]; then
      "$CMUX" workspace-action --action set-description --description "$desc" --workspace "$ws" >/dev/null 2>&1 \
        && ours=$(printf '%s' "$ours" | jq -c --arg w "$ws" --arg d "$desc" '.[$w] = $d')
    else
      "$CMUX" workspace-action --action clear-description --workspace "$ws" >/dev/null 2>&1 \
        && ours=$(printf '%s' "$ours" | jq -c --arg w "$ws" 'del(.[$w])')
    fi
  done <<EOF
$out
EOF
  # Forget workspaces that are gone.
  printf '%s\n' "$tree" | jq -c --argjson o "$ours" \
    '[.windows[]?.workspaces[]?.id] as $ids | $o | with_entries(select(.key as $k | $ids | index($k)))' \
    > "$STATE_DIR/descriptions.json" 2>/dev/null || printf '%s\n' "$ours" > "$STATE_DIR/descriptions.json"
}

# Remote text is passed as arguments, never spliced into the AppleScript source.
mac_banner() {
  osascript - "$@" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
  display notification (item 3 of argv) with title (item 1 of argv) subtitle (item 2 of argv)
end run
APPLESCRIPT
}

notify_event() {
  local host=$1 ts=$2 agent=$3 kind=$4 session=$5 cwd=$6 text=$7 name=${8:-} where=${9:-null}
  local who what title body desktop=true tree ids="" id sent=0 why
  why=$(L "no open tab" "열린 탭 없음")
  case $agent in claude) who=Claude ;; codex) who=Codex ;; *) who=$agent ;; esac
  case $kind in
    done) what=$(L "finished" "완료") ;;
    input) what=$(L "needs input" "확인 필요") ;;
    error) what=$(L "stopped on an error" "오류로 멈춤") ;;
    *) what=$(L "notice" "알림") ;;
  esac
  [ -n "$name" ] || name=$session
  title="$who $what · ${name:-$host}"
  body=$text
  [ -n "$body" ] || body=${cwd##*/}
  [ -n "$body" ] || body=$host
  [ $(( $(date +%s) - ts / 1000 )) -le "$STALE_SECONDS" ] || desktop=false
  if tree=$("$CMUX" tree --all --json --id-format both 2>"$STATE_DIR/.cmux-error"); then
    ids=$(find_targets "$host" "$session" "$tree" "$where" | awk '{ print $2 }')
  else
    why=$(L "cannot reach cmux" "cmux 연결 실패")
    log "$(L "could not reach cmux" "cmux 에 연결하지 못했어요"): $(head -n 1 "$STATE_DIR/.cmux-error")"
  fi
  for id in $ids; do
    "$CMUX" notify --surface "$id" --title "$title" --body "$body" --desktop "$desktop" >/dev/null 2>&1 && sent=1
  done
  if [ "$sent" = 1 ]; then
    log "$(L "notified tab" "알림 → 탭"): $title"
  else
    [ "$desktop" = false ] || mac_banner "$title" "$host" "$body"
    log "$(L "macOS banner" "알림 → 맥 배너") ($why): $title"
  fi
}

# Return 0 and remember the event if it is new, 1 if it was handled already.
# The first line of <host>.last is the latest time (ms); the following lines are the cksums of the
# lines handled at that time. Two sessions writing in the same ms both get through, and lines
# replayed on reconnect are skipped.
first_seen() {
  local host=$1 ts=$2 line=$3 f last seen sum
  f=$STATE_DIR/$host.last
  { read -r last; seen=$(cat); } 2>/dev/null < "$f"
  case ${last:-} in ''|*[!0-9]*) last=0 ;; esac
  sum=$(printf '%s' "$line" | cksum | awk '{ print $1 }')
  [ "$ts" -ge "$last" ] || return 1
  if [ "$ts" -eq "$last" ]; then
    # A file holding only a time (written on first start) means that line was handled.
    [ -n "${seen:-}" ] || return 1
    printf '%s\n' "$seen" | grep -qxF "$sum" && return 1
    printf '%s\n' "$sum" >> "$f"
  else
    printf '%s\n%s\n' "$ts" "$sum" > "$f"
  fi
  return 0
}

handle_line() {
  local host=$1 line=$2 fields ts agent kind session cwd text sid name viewers where
  case $line in
    '{'*) ;;
    '#'*) sync_status "$host" 1; return 0 ;;   # remote heartbeat (every minute): tidy closed tabs, restore lines
    *) [ -z "$line" ] || log "$host: $line"; return 0 ;;
  esac
  fields=$(printf '%s' "$line" | jq -r '[(.ts // 0 | tostring), .agent, .kind, .session, .cwd, .text, .sid, .name,
      (if (.viewers | type) == "array" then .viewers else null end | tojson)]
    | map((. // "") | tostring | gsub("[\u001f\r\n]"; " ")) | join("\u001f")' 2>/dev/null) || return 0
  IFS=$US read -r ts agent kind session cwd text sid name viewers <<EOF
$fields
EOF
  case $ts in ''|*[!0-9]*) return 0 ;; esac
  first_seen "$host" "$ts" "$line" || return 0
  case $viewers in '['*) where=$(jq -cn --arg n "$name" --argjson v "$viewers" '{name: $n, viewers: $v}') ;; *) viewers=null where=null ;; esac
  case $kind in
    done|input|error|note) notify_event "$host" "$ts" "$agent" "$kind" "$session" "$cwd" "$text" "$name" "$where" ;;
  esac
  [ -n "$session" ] && [ -n "$sid" ] || return 0
  update_agents "$host" "$session" "$sid" "$kind" "$ts" "$text"
  update_where "$host" "$session" "$name" "$viewers"
  sync_status "$host"
}

# The next wait, from the previous wait and how long the connection lasted.
next_delay() {
  local prev=$1 lasted=$2 d
  if [ "$lasted" -ge 60 ]; then echo "$RECONNECT_SECONDS"; return; fi
  d=$(( prev * 2 ))
  [ "$d" -le "$MAX_RECONNECT_SECONDS" ] || d=$MAX_RECONNECT_SECONDS
  echo "$d"
}

# launchd holds the log file open, so keep its inode and only cut the front.
trim_log() {
  local f=$LOG_DIR/$1.log
  [ -f "$f" ] && [ "$(wc -l < "$f" | tr -d ' ')" -gt "$LOG_KEEP_LINES" ] || return 0
  tail -n "$LOG_KEEP_LINES" "$f" > "$f.tmp" && cat "$f.tmp" > "$f"
  rm -f "$f.tmp"
}

cmd_watch() {
  local host=$1 line started delay=$RECONNECT_SECONDS
  check_host "$host"
  mkdir -p "$STATE_DIR"
  trim_log "$host"
  # On first start, do not replay old events.
  [ -s "$STATE_DIR/$host.last" ] || printf '%s000\n' "$(date +%s)" > "$STATE_DIR/$host.last"
  log "$host $(L "watching" "감시 시작") ($NAME $VERSION)"
  while :; do
    started=$(date +%s)
    # When the link ends sshd ends, tail follows it through --pid, and the heartbeat ends on its next write.
    # Each heartbeat also runs `hook.py sweep` to reap Claude sessions that died without SessionEnd.
    ssh $SSH_OPTS -n "$host" "f=$REMOTE_STATE/events.jsonl; h=$REMOTE_SHARE/hook.py; mkdir -p \"\${f%/*}\" && touch \"\$f\" || exit 1; sw() { [ ! -x \"\$h\" ] || \"\$h\" sweep >/dev/null 2>&1; }; sw; (while sleep $HEARTBEAT_SECONDS; do sw; echo '#hb' || exit; done) & exec tail -n 200 -F --pid=\$PPID \"\$f\" 2>/dev/null" 2>&1 |
      while IFS= read -r line; do handle_line "$host" "$line"; done
    delay=$(next_delay "$delay" $(( $(date +%s) - started )))
    log "$host $(L "disconnected, retrying in ${delay}s" "연결이 끊겨 ${delay}초 뒤 다시 붙어요")"
    sleep "$delay"
  done
}

install_local() {
  local root=$1
  if [ "$root" != "$SHARE_DIR" ]; then
    mkdir -p "$SHARE_DIR/bin" "$SHARE_DIR/remote"
    cp "$root/bin/$NAME" "$SHARE_DIR/bin/$NAME"
    cp "$root/remote/hook.py" "$root/remote/setup.py" "$SHARE_DIR/remote/"
    chmod 755 "$SHARE_DIR/bin/$NAME"
  fi
  mkdir -p "$(dirname "$BIN_LINK")"
  if [ -e "$BIN_LINK" ] && [ ! -h "$BIN_LINK" ]; then
    printf '    %s\n' "$(L "another file is at $BIN_LINK, so no link was made" "$BIN_LINK 에 다른 파일이 있어 링크는 만들지 않았어요")"
  else
    ln -sf "$SHARE_DIR/bin/$NAME" "$BIN_LINK"
  fi
}

write_agent() {
  local host=$1 label plist i
  label=$(label_for "$host")
  plist=$(plist_for "$host")
  mkdir -p "$AGENT_DIR" "$LOG_DIR" "$STATE_DIR"
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$SHARE_DIR/bin/$NAME</string>
    <string>watch</string>
    <string>$host</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>$LOG_DIR/$host.log</string>
  <key>StandardErrorPath</key><string>$LOG_DIR/$host.log</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null
  # Loading right after unloading can fail until the old job is gone, so try a few times.
  for i in 1 2 3 4 5; do
    launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null && return 0
    sleep 1
  done
  die "$(L "could not register with launchd" "launchd 에 등록하지 못했어요") ($plist)"
}

set_label() {
  local host=$1 name=$2 f=$STATE_DIR/labels.json new
  mkdir -p "$STATE_DIR"
  [ -s "$f" ] || echo '{}' > "$f"
  new=$(jq -c --arg h "${host##*@}" --arg n "$name" 'if $n == "" then del(.[$h]) else .[$h] = $n end' "$f") \
    && printf '%s\n' "$new" > "$f"
}

cmd_install() {
  local host=$1 label=${2-} root out
  check_host "$host"
  root=$(script_root)
  [ -f "$root/remote/hook.py" ] || die "$(L "remote/hook.py not found" "remote/hook.py 를 찾지 못했어요") ($root)"
  command -v jq >/dev/null || die "$(L "jq is required" "jq 가 필요해요")"
  command -v "$CMUX" >/dev/null || die "$(L "the cmux command was not found. This tool works only with the cmux terminal: https://cmux.com" "cmux 명령을 찾지 못했어요. 이 도구는 cmux 터미널 전용이에요: https://cmux.com")"

  echo "1/4 $(L "checking $host" "$host 접속 확인")"
  ssh $SSH_OPTS -n "$host" 'command -v python3 >/dev/null && command -v tail >/dev/null' \
    || die "$(L "could not reach $host over SSH, or it has no python3" "$host 에 SSH 로 붙지 못했거나 python3 가 없어요")"

  echo "2/4 $(L "installing on this Mac" "맥에 설치") ($SHARE_DIR)"
  install_local "$root"
  [ -z "${label+x}" ] || [ -z "$label" ] || set_label "$host" "$label"

  echo "3/4 $(L "installing the hooks on $host" "$host 에 훅 설치")"
  ssh $SSH_OPTS "$host" "mkdir -p $REMOTE_SHARE && cat > $REMOTE_SHARE/hook.py && chmod 755 $REMOTE_SHARE/hook.py" \
    < "$root/remote/hook.py" || die "$(L "could not upload the hook" "훅 파일을 올리지 못했어요")"
  out=$(ssh $SSH_OPTS "$host" python3 - install "$UI_LANG" < "$root/remote/setup.py") || {
    printf '%s\n' "$out" | sed 's/^/    /'
    die "$(L "could not change the remote settings" "원격 설정을 바꾸지 못했어요")"
  }
  printf '%s\n' "$out" | sed 's/^/    /'

  echo "4/4 $(L "starting the watcher" "맥 감시 켜기") (launchd: $(label_for "$host"))"
  write_agent "$host"

  echo
  L "Done. Claude Code picks the hooks up even in sessions that are already open.
Codex reads its settings at start, so it applies from the next Codex session.
Try it: $NAME test $host
" "다 됐어요. Claude Code 는 이미 열려 있는 세션에도 바로 적용돼요.
Codex 는 설정을 시작할 때 읽어서 새로 여는 세션부터 적용돼요.
시험: $NAME test $host
"
}

cmd_uninstall() {
  local host=$1 root out
  check_host "$host"
  root=$(script_root)
  echo "1/2 $(L "stopping the watcher" "맥 감시 끄기")"
  launchctl bootout "gui/$(id -u)/$(label_for "$host")" 2>/dev/null
  # Take our lines off the sidebar: every line we set for this host, in every workspace (a sync
  # would put back the idle lines of tabs that are still open). With no host left, clear the
  # descriptions too.
  rm -f "$(plist_for "$host")"
  clear_lines "$host"
  rm -f "$STATE_DIR/$host.last" "$STATE_DIR/$host.applied" "$STATE_DIR/$host.agents.json" "$STATE_DIR/$host.where.json"
  set_label "$host" ""
  [ -n "$(installed_hosts)" ] || clear_descriptions

  echo "2/2 $(L "removing the hooks from $host" "$host 에서 훅 빼기")"
  out=$(ssh $SSH_OPTS "$host" python3 - uninstall "$UI_LANG" < "$root/remote/setup.py") || {
    printf '%s\n' "$out" | sed 's/^/    /'
    die "$(L "could not restore the remote settings" "원격 설정을 되돌리지 못했어요")"
  }
  printf '%s\n' "$out" | sed 's/^/    /'
  ssh $SSH_OPTS -n "$host" "rm -rf $REMOTE_SHARE $REMOTE_STATE" || die "$(L "could not delete the remote files" "원격 파일을 지우지 못했어요")"
  L "Removed. The Mac copy ($SHARE_DIR) stays for other hosts.
" "다 뺐어요. 맥 실행본($SHARE_DIR)은 다른 장비용으로 남겨 뒀어요.
"
}

# Clear every sidebar line this tool set for a host, in every workspace.
clear_lines() {
  local host=$1 prefix ws key
  prefix="remote.$(printf '%s' "$host" | sed 's/[^A-Za-z0-9._-]/_/g')."
  for ws in $("$CMUX" tree --all --json --id-format both 2>/dev/null | jq -r '.windows[]?.workspaces[]?.id // empty'); do
    for key in $("$CMUX" list-status --workspace "$ws" 2>/dev/null | awk -F= -v p="$prefix" 'index($1, p) == 1 { print $1 }'); do
      "$CMUX" clear-status "$key" --workspace "$ws" >/dev/null 2>&1
    done
  done
}

# Clear every workspace description this tool wrote (ones the user changed stay).
clear_descriptions() {
  local f=$STATE_DIR/descriptions.json tree ws
  [ -s "$f" ] || return 0
  tree=$("$CMUX" tree --all --json --id-format both 2>/dev/null) || return 0
  for ws in $(printf '%s\n' "$tree" | jq -r --slurpfile o "$f" \
      '.windows[]?.workspaces[]? | select(.description != null and .description == $o[0][.id]) | .id'); do
    "$CMUX" workspace-action --action clear-description --workspace "$ws" >/dev/null 2>&1
  done
  rm -f "$f"
}

installed_hosts() {
  local plist label
  for plist in "$AGENT_DIR/$LABEL_PREFIX".*.plist; do
    [ -f "$plist" ] || continue
    label=$(basename "$plist" .plist)
    echo "${label#"$LABEL_PREFIX".}"
  done
}

watcher_pid() {
  launchctl print "gui/$(id -u)/$(label_for "$1")" 2>/dev/null | awk '$1 == "pid" { print $3; exit }'
}

cmd_status() {
  local host pid last found=0
  for host in $(installed_hosts); do
    found=1
    pid=$(watcher_pid "$host")
    if [ -n "$pid" ]; then echo "$host  $(L "watching" "감시 중") (pid $pid)"; else echo "$host  $(L "stopped" "멈춤")"; fi
    last=$(head -n 1 "$STATE_DIR/$host.last" 2>/dev/null)
    case $last in ''|*[!0-9]*) ;; *) echo "    $(L "last event" "마지막 이벤트") $(date -r $(( last / 1000 )) '+%Y-%m-%d %H:%M:%S')" ;; esac
    tail -n 3 "$LOG_DIR/$host.log" 2>/dev/null | sed 's/^/    /'
  done
  [ "$found" = 1 ] || L "No host installed. Start with '$NAME install <host>'.
" "설치된 장비가 없어요. '$NAME install <장비>' 로 시작해요.
"
}

# The checks doctor runs on the remote. Each line is "STATE|message|fix".
remote_check_script() {
  printf 'LANG_UI=%s\n' "$UI_LANG"
  cat <<'EOF'
t() { if [ "$LANG_UI" = ko ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }
d=$HOME/.local/share/cmux-remote-notify
if [ -x "$d/hook.py" ]; then echo "OK|$(t 'hook file present' '훅 파일 있음')"; else echo "BAD|$(t 'the hook file is missing' '훅 파일이 없어요')|install"; fi
command -v python3 >/dev/null || { echo "BAD|$(t 'python3 is missing' 'python3 가 없어요')|"; exit 0; }
LANG_UI=$LANG_UI python3 - <<'PY'
import json, os
ko = os.environ.get("LANG_UI") == "ko"
t = lambda en, k: k if ko else en
home = os.path.expanduser("~")
mark = "cmux-remote-notify"
p = os.path.join(home, ".claude", "settings.json")
if os.path.isdir(os.path.dirname(p)):
    try:
        data = json.load(open(p, encoding="utf-8")) if os.path.exists(p) else {}
        hooks = data.get("hooks") or {}
        events = ("Stop", "Notification", "UserPromptSubmit", "PostToolUse",
                  "StopFailure", "SessionStart", "SessionEnd")
        have = [e for e in events
                if any(mark in str(h.get("command", ""))
                       for g in hooks.get(e, []) if isinstance(g, dict)
                       for h in g.get("hooks", []) if isinstance(h, dict))]
        missing = [e for e in events if e not in have]
        if not missing:
            print("OK|" + t("Claude Code hooks (%d)", "Claude Code 훅 (알림·상태 %d개)") % len(events))
        else:
            print("BAD|" + t("Claude Code hooks are missing (%s). Another tool may have rewritten settings.json",
                             "Claude Code 훅이 빠졌어요(%s 없음). 다른 도구가 settings.json 을 덮어썼을 수 있어요")
                  % ", ".join(missing) + "|install")
    except Exception as e:
        print("BAD|" + t("could not read the Claude Code settings: %s", "Claude Code 설정을 읽지 못했어요: %s") % e + "|")
hj = os.path.join(home, ".codex", "hooks.json")
if os.path.exists(hj):
    try:
        import re
        groups = (json.load(open(hj, encoding="utf-8")).get("hooks") or {})
        ours = [(e, gi, hi) for e, gs in groups.items() if isinstance(gs, list)
                for gi, g in enumerate(gs) if isinstance(g, dict)
                for hi, h in enumerate(g.get("hooks") or []) if isinstance(h, dict) and mark in str(h.get("command", ""))]
        cfg = open(os.path.join(home, ".codex", "config.toml"), encoding="utf-8").read() \
            if os.path.exists(os.path.join(home, ".codex", "config.toml")) else ""
        trusted = set()
        for key, body in re.findall(r'\[hooks\.state\."([^"]+)"\]([^\[]*)', cfg):
            if "trusted_hash" in body:
                trusted.add(key)
        snake = lambda n: re.sub(r"(?<!^)(?=[A-Z])", "_", n).lower()
        ok = [o for o in ours if "%s:%s:%d:%d" % (hj, snake(o[0]), o[1], o[2]) in trusted]
        ran = False
        ev = os.path.join(home, ".local", "state", mark, "events.jsonl")
        if os.path.exists(ev):
            ran = any('"agent": "codex"' in l and '"sid"' in l for l in open(ev, encoding="utf-8", errors="replace"))
        if not ours:
            print("BAD|" + t("the Codex hooks are missing", "Codex 훅이 빠졌어요") + "|install")
        elif len(ok) == len(ours) or ran:
            print("OK|" + t("Codex hooks (%d), trusted", "Codex 훅 (상태 %d개), 신뢰됨") % len(ours))
        else:
            print("BAD|" + t("Codex has not trusted the hooks yet, so Codex shows no status (finished turns still notify)",
                             "Codex 가 훅을 아직 신뢰하지 않아 Codex 상태가 안 보여요(끝난 턴 알림은 와요)")
                  + "|" + t("open Codex on the host, type /hooks and trust the cmux-remote-notify hooks",
                            "장비에서 Codex 를 열고 /hooks 에서 cmux-remote-notify 훅을 신뢰해요"))
    except Exception as e:
        print("BAD|" + t("could not read the Codex hooks: %s", "Codex 훅을 읽지 못했어요: %s") % e + "|")
# The agents' own notifications would notify a second time.
try:
    sp = os.path.join(home, ".claude", "settings.json")
    ch = json.load(open(sp, encoding="utf-8")).get("preferredNotifChannel") if os.path.exists(sp) else None
    if os.path.isdir(os.path.join(home, ".claude")) and ch != "notifications_disabled":
        print("BAD|" + t("Claude Code's own notifications are on (preferredNotifChannel: %s), so a turn can notify twice",
                         "Claude Code 자체 알림이 켜져 있어요(preferredNotifChannel: %s). 알림이 두 번 올 수 있어요")
              % (ch or "auto") + "|install")
except Exception:
    pass
cp = os.path.join(home, ".codex", "config.toml")
if os.path.exists(cp):
    import re
    body = open(cp, encoding="utf-8").read()
    tui = re.search(r"^\[tui\]\s*$(.*?)(?=^\[|\Z)", body, re.M | re.S)
    if (tui and re.search(r"^\s*notifications\s*=\s*(true|\[)", tui.group(1), re.M)) \
            or re.search(r"^\s*tui\.notifications\s*=\s*(true|\[)", body, re.M):
        print("BAD|" + t("Codex's own notifications are on ([tui] notifications), so a turn can notify twice",
                         "Codex 자체 알림이 켜져 있어요([tui] notifications). 알림이 두 번 올 수 있어요") + "|install")
c = os.path.join(home, ".codex", "config.toml")
if os.path.exists(c):
    lines = open(c, encoding="utf-8").read().split("\n")
    if any(l.startswith("notify") and mark in l for l in lines):
        print("OK|Codex notify")
    elif any(l.lstrip().startswith("notify") for l in lines):
        print("INFO|" + t("Codex already has another notify, so Codex will not notify",
                          "Codex 에 다른 notify 가 있어 Codex 알림은 오지 않아요"))
    else:
        print("BAD|" + t("the Codex notify is missing", "Codex notify 가 빠졌어요") + "|install")
PY
n=0
for p in $(pgrep -x tail); do
  tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null | grep -q 'cmux-remote-notify/events.jsonl' && n=$((n + 1))
done
if [ "$n" -ge 1 ]; then echo "OK|$(t "watcher connections: $n" "맥 감시 연결 ${n}개")"; else echo "BAD|$(t 'no watcher connection. If it just dropped, check again in a minute' '맥 감시 연결이 없어요. 방금 끊겼다면 1분쯤 뒤 다시 봐요')|log"; fi
f=$HOME/.local/state/cmux-remote-notify/events.jsonl
if [ -s "$f" ]; then
  echo "INFO|$(t 'last remote event' '마지막 원격 이벤트'): $(tail -n 1 "$f" | python3 -c 'import json,sys,time; e=json.loads(sys.stdin.read()); print(time.strftime("%m-%d %H:%M:%S", time.localtime(e["ts"]/1000)), e.get("agent"), e.get("kind"), e.get("session"))' 2>/dev/null)"
fi
exit 0
EOF
}

cmd_doctor() {
  local hosts host pid mode out kind msg fix tabs st problems=0
  if [ -n "${1:-}" ]; then check_host "$1"; hosts=$1; else hosts=$(installed_hosts); fi
  [ -n "$hosts" ] || { L "No host installed. Start with '$NAME install <host>'.
" "설치된 장비가 없어요. '$NAME install <장비>' 로 시작해요.
"; return 1; }
  good()  { printf '  [%s] %s\n' "$(L ok 정상)" "$1"; }
  note()  { printf '  [%s] %s\n' "$(L info 참고)" "$1"; }
  fault() { problems=$((problems + 1)); printf '  [%s] %s\n' "$(L FAIL 문제)" "$1"; [ -z "${2:-}" ] || printf '         -> %s\n' "$2"; }

  echo "Mac"
  mode=$("$CMUX" socket-status --json 2>/dev/null | jq -r '.effective_mode // empty' 2>/dev/null)
  case $mode in
    automation) good "$(L "cmux socket control mode: automation" "cmux 소켓 제어 모드: 자동화 모드")" ;;
    allowAll|openAccess|fullOpenAccess|full) good "$(L "cmux socket control mode" "cmux 소켓 제어 모드"): $mode" ;;
    *) fault "$(L "cmux socket control mode is '${mode:-unknown}', so the watcher cannot reach cmux" "cmux 소켓 제어 모드가 '${mode:-알 수 없음}' 이라 감시 프로그램이 cmux 에 알림을 보내지 못해요")" \
         "$(L "cmux Settings > Automation > Socket control mode: Automation (or set automation.socketControlMode to \"automation\" in ~/.config/cmux/cmux.json and run cmux reload-config)" "cmux 설정 > 자동화 > 소켓 제어 모드를 '자동화 모드'로 (cmux.json 의 automation.socketControlMode 를 \"automation\" 으로 두고 cmux reload-config 해도 돼요)")" ;;
  esac

  for host in $hosts; do
    echo
    echo "$host"
    pid=$(watcher_pid "$host")
    if [ -n "$pid" ]; then good "$(L "watcher running" "맥 감시 중") (pid $pid)"; else fault "$(L "the watcher is stopped" "맥 감시가 멈춰 있어요")" "$NAME install $host"; fi
    if out=$(remote_check_script | ssh $SSH_OPTS "$host" 'bash -s' 2>&1); then
      good "$(L "SSH works" "SSH 접속")"
      while IFS='|' read -r kind msg fix; do
        case $fix in
          install) fix="$NAME install $host" ;;
          log) fix="$(L "see the log" "기록 보기"): tail -n 30 $LOG_DIR/$host.log" ;;
        esac
        case $kind in
          OK) good "$msg" ;;
          BAD) fault "$msg" "$fix" ;;
          INFO) note "$msg" ;;
        esac
      done <<EOF
$out
EOF
    else
      fault "$(L "SSH failed" "SSH 로 붙지 못했어요"): $(printf '%s\n' "$out" | tail -n 1)" \
        "$(L "check that 'ssh $host' works (VPN, keys). The watcher reconnects by itself once the network is back" "'ssh $host' 가 되는지(VPN, 키) 확인해요. 네트워크가 돌아오면 감시는 스스로 다시 붙어요")"
    fi
    st=$(jq -r 'to_entries[] | "\(.key)=" + ([.value[].s] |
        if index("running") then "Running" elif index("input") then "Needs input" else "Idle" end)' \
      "$STATE_DIR/$host.agents.json" 2>/dev/null | tr '\n' ' ')
    note "$(L "remote Claude status" "원격 Claude 상태"): ${st:-$(L none 없음)}"
    tabs=$(open_tabs "$host" | awk '{ print ($2 == "" ? "?" : $2) }' | sort -u | tr '\n' ' ')
    if [ -n "$tabs" ]; then note "$(L "tabs connected to this host (session)" "이 장비로 열린 탭(세션)"): $tabs"
    else note "$(L "no tab is connected to this host, so notifications come as macOS banners only" "이 장비로 열린 탭이 없어요. 알림은 맥 배너로만 와요")"; fi
    if [ -f "$LOG_DIR/$host.log" ]; then
      note "$(L "recent log" "최근 기록") ($LOG_DIR/$host.log)"
      tail -n 3 "$LOG_DIR/$host.log" | sed 's/^/           /'
    fi
  done
  echo
  if [ "$problems" = 0 ]; then
    L "No problems found.
" "문제 없음.
"
  else
    L "$problems thing(s) to check. Follow the -> lines; if that does not help, open an issue with this output.
" "확인할 것 ${problems}개. -> 줄대로 해 보고, 그래도 안 되면 이 출력과 함께 이슈를 남겨 주세요.
"
  fi
}

# The session of one tab connected to this host.
pick_session() { open_tabs "$1" | awk 'NF == 2 { print $2; exit }'; }

# Viewers that point at one tab connected to this host whose session is unknown.
pick_viewers() {
  connect_tabs "$1" | awk -F '\t' -v h="${1##*@}" '$2 == h && $3 == "" {
    printf "[{\"via\":\"%s\",\"start\":%d}]\n", $6, $4; exit }'
}

cmd_test() {
  local host=$1 session=${2:-} payload viewers=""
  check_host "$host"
  [ -n "$session" ] || session=$(pick_session "$host")
  [ -n "$session" ] || viewers=$(pick_viewers "$host")
  [ -n "$session" ] || session=test
  payload=$(jq -cn --arg msg "$(L "Test notification. If it shows on the '$session' tab, you are connected." "시험 알림이에요. '$session' 탭에 보이면 연결된 거예요.")" \
    '{hook_event_name: "Stop", cwd: "~", last_assistant_message: $msg}')
  printf '%s' "$payload" | ssh $SSH_OPTS "$host" \
    "CMUX_REMOTE_NOTIFY_SESSION=$(shell_quote "$session") CMUX_REMOTE_NOTIFY_VIEWERS=$(shell_quote "$viewers") $REMOTE_SHARE/hook.py claude" \
    || die "$(L "could not run the remote hook. Did you run '$NAME install $host'?" "원격 훅을 돌리지 못했어요. 먼저 '$NAME install $host' 를 했는지 확인해 주세요")"
  L "Sent a test event as session '$session' on $host. It should show within seconds.
" "$host 의 '$session' 세션 이름으로 시험 이벤트를 보냈어요. 몇 초 안에 알림이 떠야 해요.
"
}

cmd_label() {
  local host=$1
  check_host "$host"
  set_label "$host" "${2-}"
  if [ -n "${2-}" ]; then L "$host shows as '$2' in the sidebar.
" "$host 는 사이드바에 '$2' 로 보여요.
"
  else L "$host shows under its own name.
" "$host 는 원래 이름으로 보여요.
"; fi
}

case ${1:-} in
  install)
    case $# in
      2) cmd_install "$2" ;;
      4) [ "$3" = --label ] || { usage >&2; exit 2; }; cmd_install "$2" "$4" ;;
      *) usage >&2; exit 2 ;;
    esac ;;
  uninstall) [ $# -eq 2 ] || { usage >&2; exit 2; }; cmd_uninstall "$2" ;;
  status)    cmd_status ;;
  doctor)    cmd_doctor "${2:-}" ;;
  test)      [ $# -ge 2 ] || { usage >&2; exit 2; }; cmd_test "$2" "${3:-}" ;;
  label)     [ $# -ge 2 ] && [ $# -le 3 ] || { usage >&2; exit 2; }; cmd_label "$2" "${3-}" ;;
  watch)     [ $# -eq 2 ] || { usage >&2; exit 2; }; cmd_watch "$2" ;;
  _handle)   mkdir -p "$STATE_DIR"; handle_line "$2" "$3" ;;   # tests: handle one event line
  _pick)     pick_session "$2" ;;                              # tests: the session `test` would pick
  _delay)    next_delay "$2" "$3" ;;                           # tests: wait before reconnecting
  _tabs)     shift; connect_tabs "$@" ;;                       # tests: parsed connections
  -v|--version) echo "$NAME $VERSION" ;;
  ''|-h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
